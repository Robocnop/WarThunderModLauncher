<Application x:Class="WTModLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WTModLauncher.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/WarThunder.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <views:EqualsConverter x:Key="Eq" />
            <views:EqualsToVisibilityConverter x:Key="EqVis" />
            <views:BoolToVisibilityConverter x:Key="Vis" />
            <views:StatusBrushConverter x:Key="StatusBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
